<Window x:Class="Simple_PC_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple PC Manager"
        Height="740" Width="1120"
        MinHeight="560" MinWidth="880"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,10" Margin="8,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Progress bar that turns red when the bound drive is almost full -->
        <Style x:Key="DriveBar" TargetType="ProgressBar" BasedOn="{StaticResource FluentProgress}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLow}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessCardContainer" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProcessCardTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontWeight="SemiBold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,10,0"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProcessName}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Border Padding="5,1" CornerRadius="3" Margin="8,0,0,0"
                            Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PROTECTED" FontSize="8" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Id, StringFormat=PID {0}}"
                               FontSize="11" Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding WorkingSetMB, StringFormat={}{0:N1} MB}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           MinWidth="80"
                           HorizontalAlignment="Right"/>

                <Button Grid.Column="3"
                        Content="End"
                        AutomationProperties.Name="End process"
                        Style="{StaticResource DangerButton}"
                        Padding="10,3"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Click="EndProcessRow_Click"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CleanTemplate">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.Name="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Description}" FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="80">
                        <TextBlock Text="{Binding SizeText}"
                                   FontSize="16" FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding CountText}"
                                   FontSize="11" TextAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DriveTemplate">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDA2;"
                                   Foreground="{DynamicResource AccentTextBrush}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Label}" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding FreeText}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding TotalText}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                     Margin="0,6,0,0" Style="{StaticResource DriveBar}"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="Open" Margin="14,0,0,0"
                            AutomationProperties.Name="Open drive in File Explorer"
                            Style="{StaticResource GhostButton}"
                            Padding="12,4" FontSize="12"
                            VerticalAlignment="Center"
                            Click="OpenDrive_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StartupTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7B5;"
                               Foreground="{DynamicResource AccentTextBrush}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Command}" FontSize="11"
                               ToolTip="{Binding Command}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Padding="8,3" CornerRadius="4"
                        Background="{DynamicResource AccentSoftBrush}"
                        Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>

                <ToggleButton Grid.Column="3" Style="{StaticResource ToggleSwitch}"
                              AutomationProperties.Name="{Binding Name}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              Click="StartupToggle_Click"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,22,20,22">
                    <TextBlock Text="PC Manager" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Simple system utility" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged"
                         SelectedIndex="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem AutomationProperties.Name="Dashboard" ToolTip="Dashboard (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Cleaner" ToolTip="Cleaner (Ctrl+2)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Cleaner" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Processes" ToolTip="Processes (Ctrl+3, search with Ctrl+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71D;"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Processes" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Storage" ToolTip="Storage (Ctrl+4)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C3;"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Storage" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Startup" ToolTip="Startup (Ctrl+5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Startup" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16,16,16,20">
                    <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,8"/>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;"
                                           FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Dark mode" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                            <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ToggleSwitch}"
                                          AutomationProperties.Name="Dark mode"
                                          HorizontalAlignment="Right"
                                          Click="ThemeToggle_Click"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="VersionText" Text="v1.0" FontSize="11" Margin="4,12,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <!-- ===== Dashboard ===== -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,26,28,26">
                        <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Overview of your system at a glance"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0"/>

                        <Border Margin="0,22,0,0" Padding="24" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentSoftBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;"
                                                   FontSize="20" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Text="Free up disk space"
                                                   FontSize="17" FontWeight="SemiBold"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HeroStatus"
                                               Text="Scan for junk files and review them before anything is deleted"
                                               FontSize="12" Margin="30,4,0,0"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource AccentButton}"
                                        Padding="20,10"
                                        VerticalAlignment="Center"
                                        Click="ScanFromDashboard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Scan for junk" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 2 x 2 stat cards. The negative right margin cancels the last column's gutter. -->
                        <UniformGrid Columns="2" Margin="0,22,-10,0">

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,10,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;"
                                                       Foreground="{DynamicResource AccentTextBrush}" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="CPU" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="CpuUsageText" Text="-"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100"
                                                 AutomationProperties.Name="CPU usage"
                                                 Margin="0,18,0,0" Style="{StaticResource FluentProgress}"/>
                                    <TextBlock x:Name="CpuDetailText" Text="-"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,10,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE950;"
                                                       Foreground="{DynamicResource AccentTextBrush}" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Memory" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="MemUsageText" Text="-"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ProgressBar x:Name="MemBar" Minimum="0" Maximum="100"
                                                 AutomationProperties.Name="Memory usage"
                                                 Margin="0,18,0,0" Style="{StaticResource FluentProgress}"/>
                                    <TextBlock x:Name="MemDetailText" Text="-"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,10,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDA2;"
                                                       Foreground="{DynamicResource AccentTextBrush}" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="System drive" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="DiskUsageText" Text="-"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <ProgressBar x:Name="DiskBar" Minimum="0" Maximum="100"
                                                 AutomationProperties.Name="System drive usage"
                                                 Margin="0,18,0,0" Style="{StaticResource FluentProgress}"/>
                                    <TextBlock x:Name="DiskDetailText" Text="-"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,10,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71D;"
                                                       Foreground="{DynamicResource AccentTextBrush}" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Processes" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="ProcCountText" Text="-"
                                                       FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="ProcDetailText" Text="-"
                                               FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Quick actions" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,22,0,12"/>

                        <Border Style="{StaticResource Card}" Padding="20,20,12,12">
                            <StackPanel>
                                <TextBlock Text="System utilities" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Jump to Windows tools or save a report of this PC"
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,2,0,14"/>
                                <WrapPanel>
                                    <Button Content="Task Manager"
                                            Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                            Click="OpenTaskManager_Click"/>
                                    <Button Content="Windows Settings"
                                            Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                            Click="OpenSettings_Click"/>
                                    <Button Content="Installed apps"
                                            Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                            Click="OpenApps_Click"/>
                                    <Button Content="Disk Cleanup"
                                            Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                            Click="OpenDiskCleanup_Click"/>
                                    <Button Content="Export report"
                                            Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                            ToolTip="Save a text report: system, drives, top processes, startup items"
                                            Click="ExportReport_Click"/>
                                    <Button Content="Refresh (F5)"
                                            Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                                            Click="RefreshButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Cleaner ===== -->
                <Grid x:Name="CleanerPage" Margin="28,26,28,26" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Cleaner" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Scan first, then choose what to delete"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="CleanerSummary" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,18,0,0"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
                        <Button x:Name="ScanButton" Content="Scan"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="Scan_Click"/>
                        <Button x:Name="SelectAllButton" Content="Select all"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="SelectAll_Click"/>
                        <Button x:Name="SelectNoneButton" Content="Select none"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="SelectNone_Click"/>
                        <Button x:Name="CancelButton" Content="Cancel"
                                Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="CancelCleaner_Click"/>
                        <Button x:Name="CleanButton" Content="Clean selected"
                                Style="{StaticResource AccentButton}"
                                IsEnabled="False"
                                Click="Clean_Click"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="3" x:Name="CleanProgress"
                                 AutomationProperties.Name="Cleaner progress"
                                 Style="{StaticResource FluentProgress}"
                                 Margin="0,0,0,14" Visibility="Collapsed"/>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CleanList"
                                      ItemTemplate="{StaticResource CleanTemplate}"/>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Processes ===== -->
                <Grid x:Name="ProcessesPage" Margin="28,26,28,26" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Processes" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProcSubtitle"
                                   Text="Running applications, highest memory use first"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                            <TextBox x:Name="FilterBox" Style="{StaticResource SearchBox}"
                                     AutomationProperties.Name="Search processes"
                                     TextChanged="FilterBox_TextChanged"/>
                            <TextBlock Text="Search by name or PID (Ctrl+F)..."
                                       IsHitTestVisible="False"
                                       Margin="13,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Hide protected" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ToggleButton x:Name="HideProtectedToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          AutomationProperties.Name="Hide protected processes"
                                          Click="HideProtectedToggle_Click"/>
                        </StackPanel>

                        <Button x:Name="SortButton" Grid.Column="2" Content="Sort: Memory"
                                MinWidth="116" Margin="12,0,0,0"
                                ToolTip="Click to change the sort order"
                                Style="{StaticResource GhostButton}"
                                Click="SortButton_Click"/>

                        <Button Grid.Column="3" Content="Refresh" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Click="RefreshButton_Click"/>
                    </Grid>

                    <ListView x:Name="ProcessList" Grid.Row="2"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource TextBrush}"
                              ItemContainerStyle="{StaticResource ProcessCardContainer}"
                              ItemTemplate="{StaticResource ProcessCardTemplate}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionMode="Single"/>
                </Grid>

                <!-- ===== Storage ===== -->
                <Grid x:Name="StoragePage" Margin="28,26,28,26" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Storage" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Drives attached to this machine"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DriveList"
                                      ItemTemplate="{StaticResource DriveTemplate}"/>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Startup ===== -->
                <Grid x:Name="StartupPage" Margin="28,26,28,26" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Startup" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Apps that launch when Windows starts"
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,14">
                        <TextBlock x:Name="StartupSummary" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Refresh" HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}"
                                Click="RefreshStartup_Click"/>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,14,18,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ITEM" Style="{StaticResource HeaderText}"/>
                                <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource HeaderText}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <ListView x:Name="StartupList" Grid.Row="1" Margin="0,0,0,10"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource TextBrush}"
                                      ItemContainerStyle="{StaticResource RowItem}"
                                      ItemTemplate="{StaticResource StartupTemplate}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionMode="Single"/>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="ElevateButton" Grid.Column="1"
                            Content="Restart as administrator"
                            ToolTip="Needed to end some processes and change machine-wide startup items"
                            Style="{StaticResource GhostButton}"
                            Padding="10,3" FontSize="11" Margin="12,0,0,0"
                            Visibility="Collapsed"
                            Click="Elevate_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
